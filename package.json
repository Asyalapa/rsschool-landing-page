{
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-concentric-order": "^5.5.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "scripts": {
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,md,html,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,md,html,json}\""
  }
}
